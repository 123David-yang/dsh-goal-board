{
  "name": "dsh-goal-gantt",
  "version": "0.8.0",
  "description": "Goal Gantt board for DeepSeek Harness: phase-level progress timeline, current chapter, per-phase summaries and distance to goal.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gantt",
    "goal",
    "dashboard",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123David-yang/dsh-goal-gantt.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
