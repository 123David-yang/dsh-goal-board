{
  "name": "dsh-goal-gantt",
  "version": "0.27.0",
  "description": "Phase-level progress board for DeepSeek Harness: hero current phase, focused Gantt timeline, grouped phase list with filter/search, Markdown summary and CSV export (zh/en).",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "gantt",
    "goal",
    "dashboard",
    "agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/123David-yang/dsh-goal-gantt.git"
  },
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "plugin": true,
    "kind": "server",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
